#!/usr/bin/python3
"""Publish Omarchy's palette, shell styling and wallpapers as T3 Code's Thememaxed theme.

Run on theme, font, wallpaper or config changes. --style and --tint persist settings.
https://github.com/jagrat7/omarchy-t3code-thememaxed
"""

import argparse
import base64
import fcntl
import functools
import json
import os
import random
import re
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

HOME = Path.home()
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state")
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
CURRENT_DIR = STATE_HOME / "omarchy/current"
THEME_DIR = CURRENT_DIR / "theme"
USER_BACKGROUNDS = CONFIG_HOME / "omarchy/backgrounds"
CONFIG = CONFIG_HOME / "omarchy-t3code-plus/config.toml"
TEMPLATE = Path(__file__).resolve().parent.parent / "themed/t3code.css.tpl"
T3CODE_HOME = Path(os.environ.get("T3CODE_HOME") or HOME / ".t3")
STATE_DIR = T3CODE_HOME / "userdata"
TARGET = STATE_DIR / "themes/omarchy-plus.json"
THEME_NAME = "Thememaxed"
STATUS = STATE_HOME / "omarchy-t3code-plus/status.json"
LOCK = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "t3code-omarchy-plus.lock"
# T3 Code rejects a theme whose CSS is longer than this.
CSS_LIMIT = 50000
BACKGROUND_STEPS = ((960, 45), (640, 45), (640, 30), (480, 30), (320, 30))
HEADER_STEPS = ((640, 45), (480, 40), (480, 30), (320, 30), (240, 30))
# full-alt shows its wallpaper as the theme's background image: a file beside
# the theme file that T3 Code (0.1.10 and later) serves as
# --theme-background-image, so the picture is the wallpaper itself, at full
# size. T3 Code takes these formats, an earlier one winning when several are
# there, up to BACKGROUND_MAX_BYTES. Any other wallpaper is converted to WebP
# no wider than BACKGROUND_MAX_WIDTH.
BACKGROUND_FORMATS = ("webp", "png", "jpg", "jpeg")
BACKGROUND_MAX_BYTES = 16 * 1024 * 1024
BACKGROUND_MAX_WIDTH = 3840

STYLES = {
    "minimal": {"header"},
    "full": {"header", "background"},
    "max": {"header", "background", "sidebar"},
    "full-alt": {"backdrop"},
}
DEFAULT_STYLE = "full"
RENAMED_STYLES = {"too-much": "max", "backdrop": "full-alt"}
# The least the wallpaper is blurred and tinted, so text stays readable on any
# wallpaper. A theme whose own blur or tint is stronger gets its own. The blur
# is a Gaussian sigma in screen pixels; the tint is how opaque the theme's
# ground is over the picture, from 0 to 1. Both can be set in CONFIG.
MIN_BLUR = 20
MIN_TINT = 0.75
# The full-alt style tints its frosted chat column only as much as the
# wallpaper's brightness needs: a dark picture is left nearly as it is, as
# Claude's scenes are, and a bright one is dimmed to about their brightness.
# The scene at the column's sides takes a third of that. The bounds keep a
# little help for text and never hide the picture. Set a fixed tint in CONFIG
# as backdrop_tint.
BACKDROP_TINT = "auto"
BACKDROP_TINT_BOUNDS = (0.1, 0.65)
# Mean brightness, 0 to 1, that text reads well on: just above the theme's
# background, and no darker (dark themes) or lighter (light ones) than this.
BACKDROP_DARK_TARGET = 0.15
BACKDROP_LIGHT_TARGET = 0.85
IMAGE_SUFFIXES = {".jpg", ".jpeg", ".png", ".webp", ".avif", ".gif", ".bmp"}
# The Hyprland options read, and what is used when Hyprland does not answer.
HYPRLAND_DEFAULTS = {
    "decoration:rounding": 0,
    "general:border_size": 2,
    "decoration:blur:enabled": True,
    "decoration:blur:size": 8,
    "decoration:blur:passes": 1,
    "decoration:blur:brightness": 0.8172,
    "decoration:blur:contrast": 0.8916,
}

CONFIG_TEMPLATE = """\
# T3 Code Thememaxed: https://github.com/jagrat7/omarchy-t3code-thememaxed
# The plugin applies changes to this file as soon as it is saved.

# minimal:  the theme's first wallpaper behind the sidebar's header
# full:     the header, plus a theme wallpaper behind the conversation
# max:      the header and conversation, plus the wallpaper down the sidebar
# full-alt: a theme wallpaper, sharp, behind a frosted chat column
style = "{style}"

# Readability floors for the wallpaper. The theme's own blur (Hyprland) or
# tint (the shell's menu scrim) is used instead when it is stronger.
# min_blur = 20     # Gaussian sigma, in screen pixels
# min_tint = 0.75   # opacity of the theme background over the picture, 0 to 1

# full-alt only: how much the theme background covers the wallpaper behind
# the chat column, 0 to 1 (the sides take a third). "auto" sets it from the
# wallpaper's brightness.
# backdrop_tint = "auto"
"""


REPORT = {}


def warn(message):
    REPORT["warning"] = message
    print(f"T3 Code theme: {message}", file=sys.stderr)


def read_toml(path):
    try:
        return tomllib.loads(path.read_text())
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def load_settings():
    config = read_toml(CONFIG)
    style = str(config.get("style", DEFAULT_STYLE))
    if style in RENAMED_STYLES:
        style = RENAMED_STYLES[style]
        save_setting("style", f'"{style}"')
    if style not in STYLES:
        warn(f'unknown style "{style}" in {CONFIG}; using "{DEFAULT_STYLE}".')
        style = DEFAULT_STYLE

    def number(key, fallback, low, high):
        value = config.get(key, fallback)
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            warn(f"{key} in {CONFIG} is not a number; using {fallback}.")
            return fallback
        return min(max(float(value), low), high)

    return {
        "style": style,
        "min_blur": number("min_blur", MIN_BLUR, 0, 200),
        "min_tint": number("min_tint", MIN_TINT, 0, 1),
        "backdrop_tint": "auto" if config.get("backdrop_tint", BACKDROP_TINT) == "auto"
        else number("backdrop_tint", BACKDROP_TINT, 0, 1),
    }


def save_setting(name, value):
    """Record `name = value` (a TOML value) in CONFIG, keeping anything else the file says."""
    try:
        text = CONFIG.read_text()
    except OSError:
        text = CONFIG_TEMPLATE.format(style=DEFAULT_STYLE)
    line = f"{name} = {value}"
    setting = re.compile(rf"(?m)^\s*{re.escape(name)}\s*=.*$")
    if setting.search(text):
        text = setting.sub(line, text, count=1)
    elif name == "style":
        text = f"{line}\n{text}"
    else:
        text = text.rstrip("\n") + f"\n{line}\n"
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(text)


def tint_value(text):
    """The --tint argument: "auto" or a number from 0 to 1."""
    if text == "auto":
        return text
    try:
        value = float(text)
    except ValueError:
        value = -1
    if not 0 <= value <= 1:
        raise argparse.ArgumentTypeError('give "auto" or a number from 0 to 1')
    return f"{value:g}"


def command_output(*command):
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


@functools.cache
def hyprland_options():
    """Read Hyprland's options in one batch, keeping defaults for unknown options."""
    options = dict(HYPRLAND_DEFAULTS)
    batch = "; ".join(f"getoption {name}" for name in options)
    for answer in command_output("hyprctl", "-j", "--batch", batch).split("\n\n\n"):
        try:
            option = json.loads(answer)
        except ValueError:
            continue
        if isinstance(option, dict) and option.get("option") in options:
            for kind in ("int", "float", "bool"):
                if kind in option:
                    options[option["option"]] = option[kind]
                    break
    return options


def hyprland_blur():
    """The blur Hyprland puts behind translucent windows, which the selected theme sets.

    Returns None when blur is off. The radius is in screen pixels: Hyprland's
    blur reaches size * 2^passes pixels, about twice a Gaussian's sigma.
    Vibrancy and noise are not reproduced.
    """
    options = hyprland_options()
    if not options["decoration:blur:enabled"]:
        return None
    return {
        "sigma": options["decoration:blur:size"] * 2 ** options["decoration:blur:passes"] / 2,
        "brightness": float(options["decoration:blur:brightness"]),
        "contrast": float(options["decoration:blur:contrast"]),
    }


@functools.cache
def screen_width():
    """Logical width of the focused monitor, where the wallpaper is seen at full size."""
    try:
        monitors = json.loads(command_output("hyprctl", "-j", "monitors all"))
        # Hyprland's FALLBACK output stands in while every screen is off.
        monitors = [m for m in monitors if m.get("name") != "FALLBACK"]
        monitor = next((m for m in monitors if m.get("focused")), None)
        monitor = monitor or max(monitors, key=lambda m: m["width"] / (m.get("scale") or 1))
        return monitor["width"] / (monitor.get("scale") or 1)
    except (ValueError, KeyError, IndexError, TypeError):
        return 1920


def channels(digits):
    """The 0-255 values of hex digits such as "ed9998ff"."""
    return [int(digits[i : i + 2], 16) for i in range(0, len(digits), 2)]


def css_color(value, alpha=1.0):
    """One Hyprland or hex colour (rgb(ed9998), rgba(665f5899), #ed9998, 0xffed9998) as CSS."""
    value = value.strip()
    digits = None
    if match := re.fullmatch(r"#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?", value):
        digits = match.group(1) + (match.group(2) or "ff")
    elif match := re.fullmatch(r"rgba?\(([0-9a-fA-F]{6})([0-9a-fA-F]{2})?\)", value, re.I):
        digits = match.group(1) + (match.group(2) or "ff")
    elif match := re.fullmatch(r"0x([0-9a-fA-F]{2})([0-9a-fA-F]{6})", value):
        digits = match.group(2) + match.group(1)
    if digits is None:
        return None

    red, green, blue, opacity = channels(digits)
    opacity = opacity / 255 * alpha
    if opacity >= 0.999:
        return f"#{digits[:6]}"
    return f"rgb({red} {green} {blue} / {opacity:.3g})"


def parse_border(spec, alpha=1.0):
    """A solid colour or a Hyprland gradient ("rgb(a) rgb(b) 45deg") as CSS colours and an angle."""
    colors, angle = [], 0.0
    for part in str(spec).split():
        if match := re.fullmatch(r"(-?[0-9.]+)deg", part):
            angle = float(match.group(1))
        elif (color := css_color(part, alpha)) is not None:
            colors.append(color)
    return colors, angle


def css_gradient(colors, angle):
    if len(colors) == 1:
        colors = colors * 2
    # Hyprland measures the angle from left-to-right; CSS measures it from bottom-to-top.
    return f"linear-gradient({angle + 90:g}deg, {', '.join(colors)})"


def border_widths(section, prefix):
    """Top, right, bottom, left widths from a CSS-style list plus per-side overrides."""
    raw = section.get(f"{prefix}-width", 1)
    try:
        parts = [float(part) for part in str(raw).split()] or [1.0]
    except ValueError:
        parts = [1.0]
    # As in CSS, a missing side takes the width across from it (the right, the top's).
    while len(parts) < 4:
        parts.append(parts[max(len(parts) - 2, 0)])
    sides = parts[:4]
    for index, side in enumerate(("top", "right", "bottom", "left")):
        override = section.get(f"{prefix}-width-{side}")
        if isinstance(override, (int, float)):
            sides[index] = float(override)
    return sides


def is_image(path):
    return path.suffix.lower() in IMAGE_SUFFIXES and path.is_file()


def theme_name():
    try:
        return (CURRENT_DIR / "theme.name").read_text().strip()
    except OSError:
        return ""


@functools.cache
def theme_wallpapers():
    """The active theme's still wallpapers, the user's own included, in Omarchy's order."""
    name = theme_name()
    folders = [THEME_DIR / "backgrounds"]
    if name:
        folders.insert(0, USER_BACKGROUNDS / name)
    images = []
    for folder in folders:
        if folder.is_dir():
            images += [path for path in folder.iterdir() if is_image(path)]
    return sorted(images, key=str)


def first_wallpaper():
    """The theme's first still wallpaper in Omarchy's order, its default."""
    return next(iter(theme_wallpapers()), None)


def desktop_wallpaper():
    """The wallpaper on the desktop, or the theme's first when that is a video."""
    current = (CURRENT_DIR / "background").resolve()
    return current if is_image(current) else first_wallpaper()


def shown_wallpaper():
    """The wallpaper the last publish put inside T3 Code, or None."""
    try:
        shown = json.loads(STATUS.read_text()).get("wallpaper")
    except (OSError, ValueError, AttributeError):
        return None
    return Path(shown).resolve() if isinstance(shown, str) else None


def random_wallpaper():
    """One of the theme's wallpapers for inside T3 Code, dealt again on each publish.

    It avoids the desktop's, the header's and the one shown now, as far as
    the theme has others.
    """
    wallpapers = [path.resolve() for path in theme_wallpapers()]
    desktop = desktop_wallpaper()
    desktop = desktop and desktop.resolve()
    shown = shown_wallpaper()
    for taken in ((desktop, *wallpapers[:1], shown), (desktop, *wallpapers[:1]), (desktop,), ()):
        if free := [path for path in wallpapers if path not in taken]:
            return random.choice(free)
    return desktop


def hex_luminance(value):
    """Rec. 709 luma of a hex colour, from 0 to 1, as ImageMagick's Gray, or None."""
    match = re.fullmatch(r"#?([0-9a-fA-F]{6})", str(value).strip())
    if not match:
        return None
    red, green, blue = channels(match.group(1))
    return (0.2126 * red + 0.7152 * green + 0.0722 * blue) / 255


def picture_luminance(source):
    try:
        # A JPEG is decoded at a fraction of its size, which is all a mean needs.
        value = command_output("magick", "-define", "jpeg:size=256x256", f"{source}[0]", "-sample", "128x", "-colorspace", "Gray", "-format", "%[fx:mean]", "info:")
        return float(value)
    except ValueError:
        return None


def backdrop_alpha(setting, source, background):
    """How opaque the theme background is over the backdrop wallpaper."""
    if setting != "auto":
        return float(setting)
    low, high = BACKDROP_TINT_BOUNDS
    picture = picture_luminance(source) if source else None
    ground = hex_luminance(background)
    if picture is None or ground is None:
        return high
    if ground < 0.5:
        target = max(BACKDROP_DARK_TARGET, ground + 0.04)
        alpha = (picture - target) / (picture - ground) if picture > target else 0
    else:
        target = min(BACKDROP_LIGHT_TARGET, ground - 0.04)
        alpha = (target - picture) / (ground - picture) if picture < target else 0
    return min(max(alpha, low), high)


def in_parallel(function, items):
    """function(item) for each item, run side by side, in order."""
    items = list(items)
    if len(items) < 2:
        return [function(item) for item in items]
    from concurrent.futures import ThreadPoolExecutor

    with ThreadPoolExecutor(max_workers=len(items)) as pool:
        return list(pool.map(function, items))


def picture_size(source):
    """The width and height of the picture at `source`, or None."""
    # -ping reads only the header, not the pixels.
    size = command_output("magick", "identify", "-ping", "-format", "%w %h", f"{source}[0]").split()
    return (int(size[0]), int(size[1])) if len(size) == 2 and all(n.isdigit() for n in size) else None


def wallpaper_css(source, budget, steps, min_blur=None):
    """The wallpaper as a CSS image of at most `budget` characters, or "none".

    With min_blur None the picture is kept sharp and its colours untouched.
    """
    if source is None:
        return "none"
    blur = hyprland_blur() if min_blur is not None else None
    sigma = max(blur["sigma"] if blur else 0, min_blur or 0)
    screen = screen_width()
    size = picture_size(source)
    for width, quality in steps:
        # A JPEG at least twice as wide is decoded at a fraction of its size,
        # no smaller than twice the width, which is far quicker and looks the
        # same once resized. [0]: the first frame, should the file be animated.
        hint = ["-define", f"jpeg:size={2 * width}x1"] if size and size[0] >= 2 * width else []
        command = ["magick", *hint, f"{source}[0]", "-resize", f"{width}x>", "-strip"]
        # The blur is given in screen pixels, so scale it to this image.
        if sigma > 0:
            command += ["-blur", f"0x{sigma * width / screen:.3g}"]
        if blur:
            # Hyprland's blur also shifts contrast and brightness; keep the theme's.
            command += ["-function", "Polynomial", f"{blur['contrast']:g},{0.5 * (1 - blur['contrast']):g}"]
            command += ["-evaluate", "Multiply", f"{blur['brightness']:g}"]
        command += ["-quality", str(quality), "avif:-"]
        try:
            result = subprocess.run(command, capture_output=True, timeout=20)
        except (OSError, subprocess.TimeoutExpired):
            return "none"
        if result.returncode != 0 or not result.stdout:
            return "none"
        image = f'url("data:image/avif;base64,{base64.b64encode(result.stdout).decode()}")'
        if len(image) <= budget:
            return image
    return "none"


def omarchy_variables(settings):
    colors = read_toml(THEME_DIR / "colors.toml")
    shell = read_toml(THEME_DIR / "shell.toml")
    accent = colors.get("accent", "#888888")
    foreground = colors.get("foreground", "#ffffff")

    def resolve(value, fallback):
        """Follow a "section.key" reference into shell.toml, as the shell does."""
        if isinstance(value, str) and re.fullmatch(r"[a-z-]+\.[a-z-]+", value):
            section, key = value.split(".")
            value = shell.get(section, {}).get(key)
        return value if isinstance(value, str) and value else fallback

    def number(section, key, fallback):
        value = section.get(key)
        return float(value) if isinstance(value, (int, float)) else fallback

    def border(section_name, key, fallback):
        section = shell.get(section_name, {})
        alpha = number(section, f"{key}-alpha", 1.0)
        parsed, angle = parse_border(resolve(section.get(key), fallback), alpha)
        if not parsed:
            parsed, angle = parse_border(fallback, alpha)
        return parsed or [accent], angle

    active_spec = colors.get("hyprland_active_border", accent)
    active, active_angle = parse_border(active_spec)
    active = active or [accent]
    inactive = css_color(str(colors.get("hyprland_inactive_border", ""))) or colors.get("muted", "#888888")

    popup, popup_angle = border("popups", "border", active_spec)
    tooltip, tooltip_angle = border("tooltip", "border", foreground)
    row, row_angle = border("menu", "selected-border", foreground)

    menu = shell.get("menu", {})
    row_fill = css_color(str(menu.get("selected-background", foreground)), number(menu, "selected-background-alpha", 0.08))
    top, right, bottom, left = border_widths(menu, "selected-border")

    scrim = max((menu, shell.get("launcher", {})), key=lambda section: number(section, "scrim-alpha", 0.0))
    min_tint = settings["min_tint"]
    tint_alpha = min(max(number(scrim, "scrim-alpha", 0.0), min_tint), 1.0)
    background = colors.get("background", "#000000")
    tint_color = scrim.get("scrim", background) if tint_alpha > min_tint else background
    tint = css_color(str(tint_color), tint_alpha) or css_color(background, tint_alpha) or "transparent"

    font = command_output("fc-match", "monospace", "-f", "%{family}").split(",")[0].strip()
    font = json.dumps(font) if font else "monospace"

    return {
        "font": font,
        "radius": f"{hyprland_options()['decoration:rounding']}px",
        "border-width": f"{hyprland_options()['general:border_size']}px",
        "tint": tint,
        "active-border": css_gradient(active, active_angle),
        "inactive-border": inactive,
        "popup-border": css_gradient(popup, popup_angle),
        "tooltip-border": css_gradient(tooltip, tooltip_angle),
        "row-fill": row_fill or "transparent",
        "row-text": menu.get("selected-text", accent),
        "row-border": css_gradient(row, row_angle),
        "row-border-top": f"{top:g}px",
        "row-border-right": f"{right:g}px",
        "row-border-bottom": f"{bottom:g}px",
        "row-border-left": f"{left:g}px",
        "scene-card": css_color(background, 0.85) or "transparent",
        "scene-bubble": css_color(background, 0.45) or "transparent",
        "scene-line": css_color(foreground, 0.16) or "transparent",
    }


def theme_values():
    """The theme's template values, from the resolver Omarchy's own templates use."""
    output = command_output("omarchy-theme-color", "--file", str(THEME_DIR / "colors.toml"), "--all")
    values = {}
    for line in output.splitlines():
        key, tab, value = line.partition("\t")
        if not key or not tab:
            continue
        # The same three forms Omarchy offers: {{ key }}, {{ key_strip }}, {{ key_rgb }}.
        values[key] = value
        values[f"{key}_strip"] = value.removeprefix("#")
        if re.fullmatch(r"#[0-9A-Fa-f]{6}", value):
            values[f"{key}_rgb"] = ",".join(map(str, channels(value[1:])))
    return values


def render_template(text, values):
    return re.sub(r"\{\{\s*(\w+)\s*\}\}", lambda match: values.get(match.group(1), match.group(0)), text)


def keep_blocks(css, keep):
    """Drop each /* @name ... */ or /* @part name ... */ block, up to /* @end */, not in `keep`."""
    block = re.compile(r"/\* @(?:part )?([\w-]+)(?:[^*]|\*(?!/))*\*/(.*?)/\* @end \*/", re.S)
    return block.sub(lambda match: match.group(2) if match.group(1) in keep else "", css)


def picture_report(image):
    """Format, size in bytes and pixels of a data: CSS image, or None."""
    match = re.search(r"data:image/(\w+);base64,([A-Za-z0-9+/=]+)", image or "")
    if not match:
        return None
    data = base64.b64decode(match.group(2))
    try:
        size = subprocess.run(
            ["magick", "identify", "-format", "%w %h", "-"], input=data, capture_output=True, timeout=10
        ).stdout.split()
    except (OSError, subprocess.TimeoutExpired):
        size = []
    width, height = (int(size[0]), int(size[1])) if len(size) == 2 else (None, None)
    return {"format": match.group(1), "bytes": len(data), "width": width, "height": height}


def write_json(path, data, indent=2):
    write_bytes(path, (json.dumps(data, indent=indent) + "\n").encode())


def write_bytes(path, data):
    """Write `data` to `path` in one step, so a watcher never reads half a file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(handle, "wb") as file:
            file.write(data)
        os.replace(temporary, path)
    except BaseException:
        Path(temporary).unlink(missing_ok=True)
        raise


def background_picture(source):
    """`source` as T3 Code takes a theme background: (format, bytes), or None.

    A JPEG, PNG or WebP within the size limit is used as it is; anything else
    is converted to WebP.
    """
    kind = source.suffix.lower().lstrip(".")
    try:
        if kind in BACKGROUND_FORMATS and source.stat().st_size <= BACKGROUND_MAX_BYTES:
            return kind, source.read_bytes()
        data = subprocess.run(
            ["magick", f"{source}[0]", "-resize", f"{BACKGROUND_MAX_WIDTH}x>", "-quality", "90", "webp:-"],
            capture_output=True, timeout=60,
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    return ("webp", data) if data and len(data) <= BACKGROUND_MAX_BYTES else None


def publish_background(source):
    """Put `source` beside the theme as its background image, or remove it when None.

    An unchanged picture is not written again: a new file is a new revision,
    which T3 Code downloads again, with no picture while it does.
    """
    picture = background_picture(source) if source else None
    if source and picture is None:
        warn(f"could not use {source.name} as T3 Code's background image.")
    keep = TARGET.with_suffix(f".{picture[0]}") if picture else None
    # T3 Code takes the first format it finds, so no other may be left there.
    for path in (TARGET.with_suffix(f".{kind}") for kind in BACKGROUND_FORMATS):
        if path != keep:
            path.unlink(missing_ok=True)
    if keep is None:
        return
    kind, data = picture
    try:
        same = not keep.is_symlink() and keep.stat().st_size == len(data) and keep.read_bytes() == data
    except OSError:
        same = False
    if not same:
        write_bytes(keep, data)
    size = picture_size(keep) or (None, None)
    REPORT["picture"] = {"format": kind, "bytes": len(data), "width": size[0], "height": size[1]}


def write_status(settings, published):
    """Tell the bar widget what was published."""
    status = {
        "published": published,
        "time": int(time.time()),
        "style": settings["style"],
        "backdropTint": settings["backdrop_tint"],
        "theme": theme_name(),
        "limit": CSS_LIMIT,
        **REPORT,
    }
    try:
        write_json(STATUS, status)
    except OSError:
        pass


def build_css(settings, inside):
    """The CSS with the theme's colours and the Omarchy values in, or None when it cannot be used.

    `inside` is the wallpaper for inside T3 Code, or None.
    """
    try:
        css = render_template(TEMPLATE.read_text(), theme_values())
    except OSError as error:
        warn(f"could not read the CSS template: {error}")
        return None

    variables = omarchy_variables(settings)
    keep = set(STYLES[settings["style"]])
    if variables["radius"] == "0px":
        keep.add("square")
    css = keep_blocks(css, keep)
    css = re.sub(r"/\*.*?\*/", "", css, flags=re.S)
    # Every character counts against the limit the wallpaper shares, so the
    # whitespace goes. Spaces before a colon are kept: in a selector they mean
    # a descendant.
    css = re.sub(r"\s+", " ", css)
    css = re.sub(r" ?([{};,]) ?", r"\1", css)
    css = re.sub(r": ", ":", css).replace(" !important", "!important").strip()

    if unresolved := sorted(set(re.findall(r"\{\{\s*\w+\s*\}\}", css))):
        warn(f"the theme has no value for {', '.join(unresolved)}; publishing the palette without CSS.")
        return None

    if not keep & {"background", "backdrop"}:
        inside = None
    if inside:
        REPORT["wallpaper"] = str(inside)
    if "backdrop" in keep:
        colors = read_toml(THEME_DIR / "colors.toml")
        background = colors.get("background", "#000000")
        alpha = backdrop_alpha(settings["backdrop_tint"], inside, background)
        # The chat column takes the full tint; the scene at its sides a third.
        variables["scene-tint"] = css_color(background, alpha) or "transparent"
        REPORT["tint"] = round(alpha, 3)
        variables["scene-edge"] = css_color(background, alpha / 3) or "transparent"

    used = set(re.findall(r"var\(--omarchy-([\w-]+)\)", css))

    def with_variables():
        declarations = "".join(f"--omarchy-{name}:{value};" for name, value in variables.items() if name in used)
        return f":root{{{declarations}}}{css}"

    wants_header = "var(--omarchy-header-wallpaper)" in css
    wants_background = "var(--omarchy-wallpaper)" in css
    variables["header-wallpaper"] = variables["wallpaper"] = "none"
    if wants_header or wants_background:
        free = CSS_LIMIT - len(with_variables())
        share = free // 2 if wants_background else free
        header_source = first_wallpaper() if wants_header else None
        background_source = inside if wants_background else None
        variables["header-wallpaper"], variables["wallpaper"] = in_parallel(lambda job: job(), [
            lambda: wallpaper_css(header_source, share, HEADER_STEPS, settings["min_blur"]),
            lambda: wallpaper_css(background_source, free - share, BACKGROUND_STEPS[:1], settings["min_blur"]),
        ])
        if wants_background and variables["wallpaper"] == "none":
            free = CSS_LIMIT - len(with_variables())
            variables["wallpaper"] = wallpaper_css(background_source, free, BACKGROUND_STEPS, settings["min_blur"])
    css = with_variables()
    REPORT["chars"] = len(css)
    REPORT["picture"] = picture_report(variables["wallpaper"])
    if len(css) > CSS_LIMIT:
        warn(f"the CSS is {len(css)} characters, over T3 Code's {CSS_LIMIT} limit; publishing the palette without it.")
        return None
    return css


def build_theme(settings, inside):
    """Omarchy's palette for T3 Code, renamed, with the CSS added; None to leave the last one."""
    # Omarchy renders this from its t3code.json.tpl (or the theme ships it).
    source = (THEME_DIR / "t3code.json").read_text()
    if "{{" in source:
        warn("Omarchy's t3code.json has unresolved colors; leaving the previous theme in place.")
        return None
    theme = json.loads(source)
    if not isinstance(theme, dict):
        raise ValueError("t3code.json is not a theme object")
    theme["name"] = THEME_NAME
    theme.pop("css", None)
    if css := build_css(settings, inside):
        theme["css"] = css
    return theme


def kept_wallpaper():
    """The wallpaper inside T3 Code now, while it is still one of the theme's, else None."""
    shown = shown_wallpaper()
    return shown if shown in [path.resolve() for path in theme_wallpapers()] else None


def publish(settings, keep_wallpaper=False):
    """Publish the theme; `keep_wallpaper` keeps the picture shown now instead of dealing a new one."""
    if not (THEME_DIR / "t3code.json").is_file() or not STATE_DIR.is_dir():
        return False
    inside = None
    if STYLES[settings["style"]] & {"background", "backdrop"}:
        inside = (keep_wallpaper and kept_wallpaper()) or random_wallpaper()
    theme = build_theme(settings, inside)
    if theme is None:
        write_status(settings, False)
        return True

    # The picture first, so the theme that shows it finds it there.
    full_alt = "backdrop" in STYLES[settings["style"]] and "css" in theme
    publish_background(inside if full_alt else None)
    write_json(TARGET, theme)
    write_status(settings, True)
    return True


def main():
    parser = argparse.ArgumentParser(description='Publish the "Thememaxed" theme to T3 Code.')
    parser.add_argument(
        "--style",
        choices=list(STYLES),
        help="switch style and remember it: minimal (header), full (header and "
        "conversation background), max (the sidebar as well) or full-alt "
        "(the wallpaper at full size behind a frosted chat column)",
    )
    parser.add_argument(
        "--tint",
        type=tint_value,
        help='set and remember the full-alt tint: "auto" (from the wallpaper\'s brightness) or 0 to 1',
    )
    args = parser.parse_args()
    try:
        if args.style or not CONFIG.exists():
            save_setting("style", f'"{args.style or DEFAULT_STYLE}"')
        if args.tint:
            save_setting("backdrop_tint", '"auto"' if args.tint == "auto" else args.tint)
    except OSError as error:
        warn(f"could not save the config: {error}")
        if args.style or args.tint:
            return 1

    # The plugin and a hook can fire together on a theme switch; take turns.
    try:
        LOCK.parent.mkdir(parents=True, exist_ok=True)
        lock = open(LOCK, "w")
        fcntl.flock(lock, fcntl.LOCK_EX)
    except OSError:
        lock = None

    try:
        # A new tint is only a new tint: the picture under it stays.
        if not publish(load_settings(), keep_wallpaper=bool(args.tint) and not args.style) and args.style:
            warn("T3 Code or Omarchy's T3 Code palette is missing; nothing was published.")
    except (OSError, ValueError) as error:
        warn(f"could not publish the theme: {error}")
        return 1
    finally:
        if lock:
            lock.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
