#!/usr/bin/python3
"""Publish the "Omarchy+" theme to T3 Code: Omarchy's palette plus the look.

Omarchy already renders T3 Code's palette into the current theme (t3code.json)
and publishes it as T3 Code's "Omarchy" theme. This takes that palette, adds
CSS rendered from themed/t3code.css.tpl with the theme's colours, the system
font, Hyprland's rounding and borders, the shell's popup and menu styling and
the wallpapers, and publishes the result as a second theme, "Omarchy+".
Omarchy's own theme is left as it is.

Run by the plugin's service (or the hooks of the standalone install) whenever
the theme, font, wallpaper or config changes. Safe to run by hand:

    t3code-omarchy-plus                    publish the current theme
    t3code-omarchy-plus --style too-much   switch style, then publish

https://github.com/jagrat7/omarchy-t3code-thememaxed
"""

import argparse
import base64
import fcntl
import json
import math
import os
import random
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HOME = Path.home()
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state")
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
CURRENT_DIR = STATE_HOME / "omarchy/current"
THEME_DIR = CURRENT_DIR / "theme"
USER_BACKGROUNDS = CONFIG_HOME / "omarchy/backgrounds"
CONFIG = CONFIG_HOME / "omarchy-t3code-plus/config.toml"
TEMPLATE = Path(__file__).resolve().parent.parent / "themed/t3code.css.tpl"
T3CODE_HOME = Path(os.environ.get("T3CODE_HOME") or HOME / ".t3")
STATE_DIR = T3CODE_HOME / "userdata"
# A theme of its own, beside Omarchy's "omarchy", which Omarchy keeps writing.
TARGET = STATE_DIR / "themes/omarchy-plus.json"
THEME_NAME = "Omarchy+"
LOCK = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "t3code-omarchy-plus.lock"
# T3 Code rejects a theme whose CSS is longer than this.
CSS_LIMIT = 20000
# The wallpapers have to travel inside that CSS, so each is encoded as AVIF at
# the first of these widths and qualities that fits in what the rest leaves
# free. They are blurred first, so small images are enough. The header's
# picture is shown at the sidebar's width, so it starts smaller.
BACKGROUND_STEPS = ((960, 45), (640, 45), (640, 30), (480, 30), (320, 30))
HEADER_STEPS = ((640, 45), (480, 40), (480, 30), (320, 30), (240, 30))
# The backdrop style shows its one wallpaper sharp behind the conversation,
# so it has all the room to itself. avifenc (10-bit, slow, tuned for SSIM)
# packs far more detail into that room than ImageMagick, so it is used when
# installed: the widest picture that holds SHARP_GOOD_QUALITY within the room,
# at the best quality that still fits. Without it, the first of SHARP_STEPS
# that fits.
SHARP_WIDTHS = (1920, 1600, 1280, 960)
SHARP_GOOD_QUALITY = 20
SHARP_STEPS = (
    (1920, 35), (1600, 35), (1600, 25), (1280, 30), (1280, 20), (960, 25), (960, 15), (640, 20),
)
# The middle of the picture lies behind the frosted chat column, where T3 Code
# blurs it anyway, so it is softened before encoding: detail there would only
# take room from the sides. SOFT_MIDDLE is the softened band, as fractions of
# the width, narrower than the column at any usual window size; its edges fade
# over SOFT_FADE of the width, and SOFT_BLUR is the blur as a fraction too.
SOFT_MIDDLE = (0.4, 0.6)
SOFT_FADE = 0.015
SOFT_BLUR = 0.01
# Pixel art drawn at a whole-number scale (each art pixel a block of screen
# pixels) is sent at its own size and scaled up by T3 Code with hard edges,
# which keeps it crisp in a fraction of the room. Blocks up to this size are
# looked for.
PIXEL_ART_MAX_BLOCK = 16

# Which of the CSS template's optional parts each style keeps.
STYLES = {
    "minimal": {"header"},
    "full": {"header", "background"},
    "too-much": {"header", "background", "sidebar"},
    "backdrop": {"backdrop"},
}
DEFAULT_STYLE = "full"
# The least the wallpaper is blurred and tinted, so text stays readable on any
# wallpaper. A theme whose own blur or tint is stronger gets its own. The blur
# is a Gaussian sigma in screen pixels; the tint is how opaque the theme's
# ground is over the picture, from 0 to 1. Both can be set in CONFIG.
MIN_BLUR = 20
MIN_TINT = 0.75
# The backdrop style tints its frosted chat column only as much as the
# wallpaper's brightness needs: a dark picture is left nearly as it is, as
# Claude's scenes are, and a bright one is dimmed to about their brightness.
# The scene at the column's sides takes a third of that. The bounds keep a
# little help for text and never hide the picture. Set a fixed tint in CONFIG
# as backdrop_tint.
BACKDROP_TINT = "auto"
BACKDROP_TINT_BOUNDS = (0.1, 0.65)
# Mean brightness, 0 to 1, that text reads well on: just above the theme's
# background, and no darker (dark themes) or lighter (light ones) than this.
BACKDROP_DARK_TARGET = 0.15
BACKDROP_LIGHT_TARGET = 0.85
IMAGE_SUFFIXES = {".jpg", ".jpeg", ".png", ".webp", ".avif", ".gif", ".bmp"}

CONFIG_TEMPLATE = """\
# Omarchy+ for T3 Code: https://github.com/jagrat7/omarchy-t3code-thememaxed
# The plugin applies changes to this file as soon as it is saved.

# minimal:  the theme's first wallpaper behind the sidebar's header
# full:     the header, plus a random theme wallpaper behind the conversation
# too-much: the header and conversation, plus the wallpaper down the sidebar
# backdrop: the desktop wallpaper, sharp, behind a frosted chat column
style = "{style}"

# Readability floors for the wallpaper. The theme's own blur (Hyprland) or
# tint (the shell's menu scrim) is used instead when it is stronger.
# min_blur = 20     # Gaussian sigma, in screen pixels
# min_tint = 0.75   # opacity of the theme background over the picture, 0 to 1

# backdrop only: how much the theme background covers the wallpaper behind
# the chat column, 0 to 1 (the sides take a third). "auto" sets it from the
# wallpaper's brightness.
# backdrop_tint = "auto"
"""


def warn(message):
    print(f"T3 Code theme: {message}", file=sys.stderr)


def read_toml(path):
    try:
        return tomllib.loads(path.read_text())
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def load_settings():
    config = read_toml(CONFIG)
    style = config.get("style", DEFAULT_STYLE)
    if style not in STYLES:
        warn(f'unknown style "{style}" in {CONFIG}; using "{DEFAULT_STYLE}".')
        style = DEFAULT_STYLE

    def number(key, fallback, low, high):
        value = config.get(key, fallback)
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            warn(f"{key} in {CONFIG} is not a number; using {fallback}.")
            return fallback
        return min(max(float(value), low), high)

    return {
        "style": style,
        "min_blur": number("min_blur", MIN_BLUR, 0, 200),
        "min_tint": number("min_tint", MIN_TINT, 0, 1),
        "backdrop_tint": "auto" if config.get("backdrop_tint", BACKDROP_TINT) == "auto"
        else number("backdrop_tint", BACKDROP_TINT, 0, 1),
    }


def save_style(style):
    """Record the style in CONFIG, keeping anything else the file says."""
    try:
        text = CONFIG.read_text()
    except OSError:
        text = None
    line = f'style = "{style}"'
    if text is None:
        text = CONFIG_TEMPLATE.format(style=style)
    elif re.search(r"(?m)^\s*style\s*=.*$", text):
        text = re.sub(r"(?m)^\s*style\s*=.*$", line, text, count=1)
    else:
        text = f"{line}\n{text}"
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(text)


def command_output(*command):
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return result.stdout.strip() if result.returncode == 0 else ""


def hyprland_option(name, fallback):
    try:
        option = json.loads(command_output("hyprctl", "-j", "getoption", name))
    except ValueError:
        return fallback
    for kind in ("int", "float", "bool"):
        if isinstance(option, dict) and kind in option:
            return option[kind]
    return fallback


def hyprland_blur():
    """The blur Hyprland puts behind translucent windows, which the selected theme sets.

    Returns None when blur is off. The radius is in screen pixels: Hyprland's
    blur reaches size * 2^passes pixels, about twice a Gaussian's sigma.
    Vibrancy and noise are not reproduced.
    """
    if not hyprland_option("decoration:blur:enabled", True):
        return None
    size = hyprland_option("decoration:blur:size", 8)
    passes = hyprland_option("decoration:blur:passes", 1)
    return {
        "sigma": size * 2**passes / 2,
        "brightness": float(hyprland_option("decoration:blur:brightness", 0.8172)),
        "contrast": float(hyprland_option("decoration:blur:contrast", 0.8916)),
    }


def screen_width():
    """Logical width of the focused monitor, where the wallpaper is seen at full size."""
    try:
        monitors = json.loads(command_output("hyprctl", "-j", "monitors all"))
        # Hyprland's FALLBACK output stands in while every screen is off.
        monitors = [m for m in monitors if m.get("name") != "FALLBACK"]
        monitor = next((m for m in monitors if m.get("focused")), None)
        monitor = monitor or max(monitors, key=lambda m: m["width"] / (m.get("scale") or 1))
        return monitor["width"] / (monitor.get("scale") or 1)
    except (ValueError, KeyError, IndexError, TypeError):
        return 1920


def css_color(value, alpha=1.0):
    """One Hyprland or hex colour (rgb(ed9998), rgba(665f5899), #ed9998, 0xffed9998) as CSS."""
    value = value.strip()
    digits = None
    if match := re.fullmatch(r"#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?", value):
        digits = match.group(1) + (match.group(2) or "ff")
    elif match := re.fullmatch(r"rgba?\(([0-9a-fA-F]{6})([0-9a-fA-F]{2})?\)", value, re.I):
        digits = match.group(1) + (match.group(2) or "ff")
    elif match := re.fullmatch(r"0x([0-9a-fA-F]{2})([0-9a-fA-F]{6})", value):
        digits = match.group(2) + match.group(1)
    if digits is None:
        return None

    red, green, blue, opacity = (int(digits[i : i + 2], 16) for i in (0, 2, 4, 6))
    opacity = opacity / 255 * alpha
    if opacity >= 0.999:
        return f"#{digits[:6]}"
    return f"rgb({red} {green} {blue} / {opacity:.3g})"


def parse_border(spec, alpha=1.0):
    """A solid colour or a Hyprland gradient ("rgb(a) rgb(b) 45deg") as CSS colours and an angle."""
    colors, angle = [], 0.0
    for part in str(spec).split():
        if match := re.fullmatch(r"(-?[0-9.]+)deg", part):
            angle = float(match.group(1))
        elif (color := css_color(part, alpha)) is not None:
            colors.append(color)
    return colors, angle


def css_gradient(colors, angle):
    if len(colors) == 1:
        colors = colors * 2
    # Hyprland measures the angle from left-to-right; CSS measures it from bottom-to-top.
    return f"linear-gradient({angle + 90:g}deg, {', '.join(colors)})"


def border_widths(section, prefix):
    """Top, right, bottom, left widths from a CSS-style list plus per-side overrides."""
    raw = section.get(f"{prefix}-width", 1)
    try:
        parts = [float(part) for part in str(raw).split()] or [1.0]
    except ValueError:
        parts = [1.0]
    if len(parts) == 1:
        sides = parts * 4
    elif len(parts) == 2:
        sides = [parts[0], parts[1], parts[0], parts[1]]
    elif len(parts) == 3:
        sides = [parts[0], parts[1], parts[2], parts[1]]
    else:
        sides = parts[:4]
    for index, side in enumerate(("top", "right", "bottom", "left")):
        override = section.get(f"{prefix}-width-{side}")
        if isinstance(override, (int, float)):
            sides[index] = float(override)
    return sides


def is_image(path):
    return path.is_file() and path.suffix.lower() in IMAGE_SUFFIXES


def theme_wallpapers():
    """The active theme's still wallpapers, the user's own included, in Omarchy's order."""
    try:
        name = (CURRENT_DIR / "theme.name").read_text().strip()
    except OSError:
        name = ""
    folders = [THEME_DIR / "backgrounds"]
    if name:
        folders.insert(0, USER_BACKGROUNDS / name)
    images = []
    for folder in folders:
        if folder.is_dir():
            images += [path for path in folder.iterdir() if is_image(path)]
    return sorted(images, key=str)


def first_wallpaper():
    """The theme's first still wallpaper in Omarchy's order, its default."""
    wallpapers = theme_wallpapers()
    return wallpapers[0] if wallpapers else None


def desktop_wallpaper():
    """The wallpaper on the desktop, or the theme's first when that is a video."""
    current = (CURRENT_DIR / "background").resolve()
    return current if is_image(current) else first_wallpaper()


def random_wallpaper():
    wallpapers = theme_wallpapers()
    return random.choice(wallpapers) if wallpapers else desktop_wallpaper()


def luminance(red, green, blue):
    """Rec. 709 luma of 0-255 sRGB values, from 0 to 1, as ImageMagick's Gray."""
    return (0.2126 * red + 0.7152 * green + 0.0722 * blue) / 255


def hex_luminance(value):
    match = re.fullmatch(r"#?([0-9a-fA-F]{6})", str(value).strip())
    if not match:
        return None
    digits = match.group(1)
    return luminance(*(int(digits[i : i + 2], 16) for i in (0, 2, 4)))


def picture_luminance(source):
    try:
        value = command_output("magick", f"{source}[0]", "-sample", "128x", "-colorspace", "Gray", "-format", "%[fx:mean]", "info:")
        return float(value)
    except ValueError:
        return None


def backdrop_alpha(setting, source, background):
    """How opaque the theme background is over the backdrop wallpaper."""
    if setting != "auto":
        return float(setting)
    low, high = BACKDROP_TINT_BOUNDS
    picture = picture_luminance(source) if source else None
    ground = hex_luminance(background)
    if picture is None or ground is None:
        return high
    if ground < 0.5:
        target = max(BACKDROP_DARK_TARGET, ground + 0.04)
        alpha = (picture - target) / (picture - ground) if picture > target else 0
    else:
        target = min(BACKDROP_LIGHT_TARGET, ground - 0.04)
        alpha = (target - picture) / (ground - picture) if picture < target else 0
    return min(max(alpha, low), high)


def in_parallel(function, items):
    """function(item) for each item, run side by side, in order."""
    items = list(items)
    with ThreadPoolExecutor(max_workers=max(1, len(items))) as pool:
        return list(pool.map(function, items))


def picture_size(source):
    """The width and height of the picture at `source`, or None."""
    size = command_output("magick", "identify", "-format", "%w %h", f"{source}[0]").split()
    return (int(size[0]), int(size[1])) if len(size) == 2 and all(n.isdigit() for n in size) else None


def pixel_block(source, width, height):
    """The side of the square each pixel of pixel art is drawn as, or 1 for any other picture."""

    def exact(block):
        # Shrunk to one pixel per block and grown back, pixel art comes back as it was.
        command = [
            "magick", f"{source}[0]", "(", "+clone", "-sample", f"{width // block}x{height // block}!",
            "-sample", f"{width}x{height}!", ")", "-fuzz", "1%", "-metric", "AE", "-compare",
            "-format", "%[distortion]", "info:",
        ]
        try:
            result = subprocess.run(command, capture_output=True, text=True, timeout=20)
            return result.returncode == 0 and float(result.stdout) <= 0.0002
        except (OSError, subprocess.TimeoutExpired, ValueError):
            return False

    blocks = [block for block in range(2, PIXEL_ART_MAX_BLOCK + 1) if width % block == 0 and height % block == 0]
    # Art drawn in blocks of n is also drawn in blocks of each factor of n, so
    # a picture that no prime passes is not pixel art; most pictures stop here.
    primes = [block for block in blocks if all(block % factor for factor in range(2, block))]
    on_primes = in_parallel(exact, primes)
    if not any(on_primes):
        return 1
    others = [block for block in blocks if block not in primes]
    passed = [block for block, ok in zip(primes + others, on_primes + in_parallel(exact, others)) if ok]
    return max(passed, default=1)


def sharp_wallpaper_css(source, budget):
    """The wallpaper unblurred but for its middle, as large and clean as `budget` characters allow.

    Returns the CSS image ("none" without one) and how T3 Code should scale it
    up: "pixelated" for pixel art, otherwise "auto".
    """
    if source is None:
        return "none", "auto"
    if not shutil.which("avifenc"):
        return wallpaper_css(source, budget, SHARP_STEPS), "auto"
    size = picture_size(source)
    if size is None:
        return "none", "auto"
    block = pixel_block(source, *size)

    def as_css(kind, data):
        return f'url("data:image/{kind};base64,{base64.b64encode(data).decode()}")'

    def room(kind):
        return (budget - len(as_css(kind, b""))) * 3 // 4

    with tempfile.TemporaryDirectory() as folder:

        def picture(width, soften=True):
            """The wallpaper at `width` as a PNG, its middle softened, or None."""
            height = round(size[1] * width / size[0])
            png = Path(folder) / f"{width}{'s' if soften else ''}.png"
            # -sample keeps pixel art's hard edges; photos are resized smoothly.
            command = ["magick", f"{source}[0]", "-sample" if block > 1 else "-resize", f"{width}x{height}!", "-strip"]
            if soften:
                # Blurred at a quarter of the size, which looks the same and
                # is far quicker, then laid over the middle through a band
                # that fades at its edges.
                left, right = (round(width * edge) for edge in SOFT_MIDDLE)
                command += [
                    "(", "+clone", "-scale", "25%", "-blur", f"0x{width * SOFT_BLUR / 4:.3g}", "-resize", f"{width}x{height}!",
                    "(", "-size", f"{width}x1", "xc:black", "-fill", "white", "-draw", f"rectangle {left},0 {right},0",
                    "-blur", f"0x{width * SOFT_FADE:.3g}", "-scale", f"{width}x{height}!", ")",
                    "-alpha", "off", "-compose", "CopyOpacity", "-composite", ")",
                    "-compose", "Over", "-composite", "-alpha", "off",
                ]
            try:
                result = subprocess.run([*command, str(png)], capture_output=True, timeout=30)
            except (OSError, subprocess.TimeoutExpired):
                return None
            return png if result.returncode == 0 else None

        def encode(png, quality):
            out = Path(folder) / f"{png.stem}-{quality}.avif"
            command = ["avifenc", "-q", str(quality), "-s", "3", "-d", "10", "-y", "420", "-a", "tune=ssim", str(png), str(out)]
            try:
                result = subprocess.run(command, capture_output=True, timeout=60)
            except (OSError, subprocess.TimeoutExpired):
                return None
            return out.read_bytes() if result.returncode == 0 and out.is_file() else None

        def best_fit(png, low, high, tried=None):
            """The highest quality from low to high whose picture fits, as (quality, bytes).

            `tried` maps qualities already encoded to their sizes. A picture
            grows about exponentially with quality, so once one try fits and
            one does not, the next aims where the two say the room runs out:
            three or four tries where halving the range would take six or seven.
            """
            tried = dict(tried or {})
            target = room("avif")
            found = None
            while low <= high:
                fits = max((quality for quality, length in tried.items() if length <= target), default=None)
                over = min((quality for quality, length in tried.items() if length > target), default=None)
                if fits is not None and over is not None and over > fits and tried[fits] > 0:
                    growth = math.log(tried[over] / tried[fits]) / (over - fits)
                    quality = fits + math.log(target / tried[fits]) / growth if growth > 0 else low
                    quality = min(max(int(quality), low), high)
                else:
                    quality = (low + high) // 2
                data = encode(png, quality)
                if data is None:
                    return found
                tried[quality] = len(data)
                if len(data) <= target:
                    found, low = (quality, data), quality + 1
                else:
                    high = quality - 1
            return found

        if block > 1:
            # Pixel art at its own size: whole when lossless WebP fits, which
            # keeps every pixel exact, otherwise the best AVIF that fits.
            native = size[0] // block
            png = picture(native, soften=False)
            if png is None:
                return "none", "auto"
            try:
                webp = subprocess.run(
                    ["magick", str(png), "-define", "webp:lossless=true", "-define", "webp:method=6", "webp:-"],
                    capture_output=True, timeout=30,
                ).stdout
            except (OSError, subprocess.TimeoutExpired):
                webp = b""
            if webp and len(webp) <= room("webp"):
                return as_css("webp", webp), "pixelated"
            png = picture(native)
            chosen = png and best_fit(png, 0, 95)
            if chosen:
                return as_css("avif", chosen[1]), "pixelated"

        # Every width is prepared and tried at the good quality side by side
        # (never wider than the picture itself); the widest that holds it wins.
        widths = list(dict.fromkeys(min(width, size[0]) for width in SHARP_WIDTHS))
        pngs = in_parallel(picture, widths)
        if None in pngs:
            return "none", "auto"
        goods = in_parallel(lambda png: encode(png, SHARP_GOOD_QUALITY), pngs)
        for png, good in zip(pngs, goods):
            if good is not None and len(good) <= room("avif"):
                chosen = best_fit(png, SHARP_GOOD_QUALITY + 1, 90, {SHARP_GOOD_QUALITY: len(good)}) or (SHARP_GOOD_QUALITY, good)
                break
        else:
            # Not even the smallest width holds a good quality: the best it can.
            chosen = best_fit(pngs[-1], 0, SHARP_GOOD_QUALITY - 1, {SHARP_GOOD_QUALITY: len(goods[-1] or b"x" * (room("avif") + 1))})
    if chosen is None:
        return "none", "auto"
    return as_css("avif", chosen[1]), "auto"


def wallpaper_css(source, budget, steps, min_blur=None):
    """The wallpaper as a CSS image of at most `budget` characters, or "none".

    With min_blur None the picture is kept sharp and its colours untouched.
    """
    if source is None:
        return "none"
    blur = hyprland_blur() if min_blur is not None else None
    sigma = max(blur["sigma"] if blur else 0, min_blur or 0)
    screen = screen_width()
    for width, quality in steps:
        # [0]: the first frame, should the file be animated.
        command = ["magick", f"{source}[0]", "-resize", f"{width}x>", "-strip"]
        # The blur is given in screen pixels, so scale it to this image.
        if sigma > 0:
            command += ["-blur", f"0x{sigma * width / screen:.3g}"]
        if blur:
            # Hyprland's blur also shifts contrast and brightness; keep the theme's.
            command += ["-function", "Polynomial", f"{blur['contrast']:g},{0.5 * (1 - blur['contrast']):g}"]
            command += ["-evaluate", "Multiply", f"{blur['brightness']:g}"]
        command += ["-quality", str(quality), "avif:-"]
        try:
            result = subprocess.run(command, capture_output=True, timeout=20)
        except (OSError, subprocess.TimeoutExpired):
            return "none"
        if result.returncode != 0 or not result.stdout:
            return "none"
        image = f'url("data:image/avif;base64,{base64.b64encode(result.stdout).decode()}")'
        if len(image) <= budget:
            return image
    return "none"


def omarchy_variables(settings):
    colors = read_toml(THEME_DIR / "colors.toml")
    shell = read_toml(THEME_DIR / "shell.toml")
    accent = colors.get("accent", "#888888")
    foreground = colors.get("foreground", "#ffffff")

    def resolve(value, fallback):
        """Follow a "section.key" reference into shell.toml, as the shell does."""
        if isinstance(value, str) and re.fullmatch(r"[a-z-]+\.[a-z-]+", value):
            section, key = value.split(".")
            value = shell.get(section, {}).get(key)
        return value if isinstance(value, str) and value else fallback

    def border(section_name, key, fallback):
        section = shell.get(section_name, {})
        alpha = section.get(f"{key}-alpha", 1.0)
        alpha = float(alpha) if isinstance(alpha, (int, float)) else 1.0
        parsed, angle = parse_border(resolve(section.get(key), fallback), alpha)
        if not parsed:
            parsed, angle = parse_border(fallback, alpha)
        return parsed or [accent], angle

    active_spec = colors.get("hyprland_active_border", accent)
    active, active_angle = parse_border(active_spec)
    active = active or [accent]
    inactive = css_color(str(colors.get("hyprland_inactive_border", ""))) or colors.get("muted", "#888888")

    popup, popup_angle = border("popups", "border", active_spec)
    tooltip, tooltip_angle = border("tooltip", "border", foreground)
    row, row_angle = border("menu", "selected-border", foreground)

    menu = shell.get("menu", {})
    row_fill_alpha = menu.get("selected-background-alpha", 0.08)
    row_fill = css_color(str(menu.get("selected-background", foreground)), float(row_fill_alpha))
    top, right, bottom, left = border_widths(menu, "selected-border")

    # The theme's tint is the scrim the shell lays over the desktop behind its
    # menu and launcher. It is used when it is heavier than the minimum.
    scrim = menu
    for name in ("menu", "launcher"):
        section = shell.get(name, {})
        alpha = section.get("scrim-alpha")
        if isinstance(alpha, (int, float)) and alpha > scrim.get("scrim-alpha", 0):
            scrim = section
    tint_alpha = scrim.get("scrim-alpha", 0)
    tint_alpha = float(tint_alpha) if isinstance(tint_alpha, (int, float)) else 0.0
    min_tint = settings["min_tint"]
    tint_alpha = min(max(tint_alpha, min_tint), 1.0)
    background = colors.get("background", "#000000")
    tint_color = scrim.get("scrim", background) if tint_alpha > min_tint else background
    tint = css_color(str(tint_color), tint_alpha) or css_color(background, tint_alpha) or "transparent"

    # The backdrop style's cards, of the theme's own colours. The chat
    # column's tint depends on the wallpaper, so build_css adds it.
    scene_values = {
        "scene-card": css_color(background, 0.85),
        "scene-bubble": css_color(background, 0.45),
        "scene-line": css_color(foreground, 0.16),
    }
    scene_values = {name: value or "transparent" for name, value in scene_values.items()}

    font = command_output("fc-match", "monospace", "-f", "%{family}").split(",")[0].strip()
    font = json.dumps(font) if font else "monospace"

    return {
        "font": font,
        "radius": f"{hyprland_option('decoration:rounding', 0)}px",
        "border-width": f"{hyprland_option('general:border_size', 2)}px",
        "tint": tint,
        "active-border": css_gradient(active, active_angle),
        "inactive-border": inactive,
        "popup-border": css_gradient(popup, popup_angle),
        "tooltip-border": css_gradient(tooltip, tooltip_angle),
        "row-fill": row_fill or "transparent",
        "row-text": menu.get("selected-text", accent),
        "row-border": css_gradient(row, row_angle),
        "row-edge-top": row[0],
        "row-edge-bottom": row[-1],
        "row-border-top": f"{top:g}px",
        "row-border-right": f"{right:g}px",
        "row-border-bottom": f"{bottom:g}px",
        "row-border-left": f"{left:g}px",
        **scene_values,
    }


def theme_values():
    """The theme's template values, from the resolver Omarchy's own templates use."""
    output = command_output("omarchy-theme-color", "--file", str(THEME_DIR / "colors.toml"), "--all")
    values = {}
    for line in output.splitlines():
        key, _, value = line.partition("\t")
        if not key or not _:
            continue
        # The same three forms Omarchy offers: {{ key }}, {{ key_strip }}, {{ key_rgb }}.
        values[key] = value
        values[f"{key}_strip"] = value.removeprefix("#")
        if re.fullmatch(r"#[0-9A-Fa-f]{6}", value):
            values[f"{key}_rgb"] = ",".join(str(int(value[i : i + 2], 16)) for i in (1, 3, 5))
    return values


def render_template(text, values):
    return re.sub(r"\{\{\s*(\w+)\s*\}\}", lambda match: values.get(match.group(1), match.group(0)), text)


def keep_blocks(css, keep):
    """Drop each /* @name ... */ or /* @part name ... */ block, up to /* @end */, not in `keep`."""
    block = re.compile(r"/\* @(?:part )?([\w-]+)(?:[^*]|\*(?!/))*\*/(.*?)/\* @end \*/", re.S)
    return block.sub(lambda match: match.group(2) if match.group(1) in keep else "", css)


def build_css(settings):
    """The CSS with the theme's colours and the Omarchy values in, or None when it cannot be used."""
    try:
        css = render_template(TEMPLATE.read_text(), theme_values())
    except OSError as error:
        warn(f"could not read the CSS template: {error}")
        return None

    variables = omarchy_variables(settings)
    keep = set(STYLES[settings["style"]])
    if variables["radius"] == "0px":
        keep.add("square")
    css = keep_blocks(css, keep)
    css = re.sub(r"/\*.*?\*/", "", css, flags=re.S)
    # Every character counts against the limit the wallpaper shares, so the
    # whitespace goes. Spaces before a colon are kept: in a selector they mean
    # a descendant.
    css = re.sub(r"\s+", " ", css)
    css = re.sub(r" ?([{};,]) ?", r"\1", css)
    css = re.sub(r": ", ":", css).replace(" !important", "!important").strip()

    if unresolved := sorted(set(re.findall(r"\{\{\s*\w+\s*\}\}", css))):
        warn(f"the theme has no value for {', '.join(unresolved)}; publishing the palette without CSS.")
        return None

    if "backdrop" in keep:
        colors = read_toml(THEME_DIR / "colors.toml")
        background = colors.get("background", "#000000")
        alpha = backdrop_alpha(settings.get("backdrop_tint", BACKDROP_TINT), desktop_wallpaper(), background)
        # The chat column takes the full tint; the scene at its sides a third.
        variables["scene-tint"] = css_color(background, alpha) or "transparent"
        variables["scene-edge"] = css_color(background, alpha / 3) or "transparent"

    def with_variables():
        # Only the values this style uses, to leave the wallpaper more room.
        used = {name: value for name, value in variables.items() if f"var(--omarchy-{name})" in css}
        declarations = "".join(f"--omarchy-{name}:{value};" for name, value in used.items())
        return f":root{{{declarations}}}{css}"

    # The header always shows the theme's first wallpaper; the conversation a
    # random one. Each is encoded only if the style uses it, and the header's picture
    # may take at most half of the room left when both are needed.
    wants_header = "var(--omarchy-header-wallpaper)" in css
    wants_background = "var(--omarchy-wallpaper)" in css
    variables["header-wallpaper"] = variables["wallpaper"] = "none"
    if wants_header:
        free = CSS_LIMIT - len(with_variables())
        share = free // 2 if wants_background else free
        variables["header-wallpaper"] = wallpaper_css(first_wallpaper(), share, HEADER_STEPS, settings["min_blur"])
    if wants_background:
        free = CSS_LIMIT - len(with_variables())
        if "backdrop" in keep:
            # Sized as if pixelated, the longer of the two renderings.
            variables["wallpaper-rendering"] = "pixelated"
            free = CSS_LIMIT - len(with_variables())
            variables["wallpaper"], variables["wallpaper-rendering"] = sharp_wallpaper_css(desktop_wallpaper(), free)
        else:
            variables["wallpaper"] = wallpaper_css(random_wallpaper(), free, BACKGROUND_STEPS, settings["min_blur"])
    css = with_variables()
    if len(css) > CSS_LIMIT:
        warn(f"the CSS is {len(css)} characters, over T3 Code's {CSS_LIMIT} limit; publishing the palette without it.")
        return None
    return css


def build_theme(settings):
    """Omarchy's palette for T3 Code, renamed, with the CSS added; None to leave the last one."""
    # Omarchy renders this from its t3code.json.tpl (or the theme ships it).
    source = (THEME_DIR / "t3code.json").read_text()
    if "{{" in source:
        warn("Omarchy's t3code.json has unresolved colors; leaving the previous theme in place.")
        return None
    theme = json.loads(source)
    if not isinstance(theme, dict):
        raise ValueError("t3code.json is not a theme object")
    theme["name"] = THEME_NAME
    theme.pop("css", None)
    if css := build_css(settings):
        theme["css"] = css
    return theme


def publish(settings):
    # Only follow an install that already exists.
    if not (THEME_DIR / "t3code.json").is_file() or not STATE_DIR.is_dir():
        return False
    theme = build_theme(settings)
    if theme is None:
        return True

    # T3 Code watches this file, so the write has to be atomic.
    TARGET.parent.mkdir(parents=True, exist_ok=True)
    handle, temporary = tempfile.mkstemp(prefix=f"{TARGET.name}.", dir=TARGET.parent)
    try:
        with os.fdopen(handle, "w") as file:
            json.dump(theme, file, indent=2)
            file.write("\n")
        os.replace(temporary, TARGET)
    except BaseException:
        Path(temporary).unlink(missing_ok=True)
        raise
    return True


def main():
    parser = argparse.ArgumentParser(description='Publish the "Omarchy+" theme to T3 Code.')
    parser.add_argument(
        "--style",
        choices=list(STYLES),
        help="switch style and remember it: minimal (header), full (header and "
        "conversation background), too-much (the sidebar as well) or backdrop "
        "(the sharp desktop wallpaper behind a frosted chat column)",
    )
    args = parser.parse_args()
    # A first run writes the config with its defaults, so there is a file to edit.
    if args.style or not CONFIG.exists():
        try:
            save_style(args.style or DEFAULT_STYLE)
        except OSError as error:
            warn(f"could not save the config: {error}")
            if args.style:
                return 1

    # The plugin and a hook can fire together on a theme switch; take turns.
    try:
        LOCK.parent.mkdir(parents=True, exist_ok=True)
        lock = open(LOCK, "w")
        fcntl.flock(lock, fcntl.LOCK_EX)
    except OSError:
        lock = None

    try:
        if not publish(load_settings()) and args.style:
            warn("T3 Code or Omarchy's T3 Code palette is missing; nothing was published.")
    except (OSError, ValueError) as error:
        warn(f"could not publish the theme: {error}")
        return 1
    finally:
        if lock:
            lock.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
